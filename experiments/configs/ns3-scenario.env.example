# Workspace
A1GENT_NS3_DIR=workspace/ns-3.42

# Scenario entrypoint
# ns-3 program name under contrib/oran/examples
A1GENT_NS3_SCENARIO=oran-lte-2-lte-ml-handover-example

# O-RAN and handover
# 1 = enable the O-RAN stack
NS3_USE_ORAN=1
# ns-3 handover algorithm class
NS3_HANDOVER_ALGORITHM=ns3::A2A4RsrqHandoverAlgorithm
# Command bridge query interval in seconds
NS3_LM_QUERY_INTERVAL=2

# Topology
# 1 = place sites on a hex grid
NS3_USE_HEX=1
# Number of macro sites
NS3_NUM_SITES=3
# Number of UEs
NS3_NUM_UES=20
# Inter-site distance in meters
NS3_ISD=200

# Baseline eMBB traffic
# Per-UE on/off traffic profile
NS3_EMBB_BASE_RATE=12Mbps
NS3_EMBB_BASE_ON=0.6
NS3_EMBB_BASE_OFF=1.4
NS3_EMBB_HOT_RATE=28Mbps
NS3_EMBB_HOT_ON=1.4
NS3_EMBB_HOT_OFF=0.25
NS3_EMBB_HOT_MODULO=3
NS3_EMBB_HOT_OFFSET=0

# Emergency traffic window
# Extra traffic injected during the emergency interval
NS3_EMERG_START=60
NS3_EMERG_DURATION=90
NS3_EMERG_BOOST_UL=1
NS3_EMERG_HOT_MODULO=3
NS3_EMERG_HOT_OFFSET=0

# Outputs and runtime
# SQLite database file written under the ns-3 directory
NS3_DB_FILE=oran-repository.db
# Total simulation time in seconds
NS3_SIM_TIME=300

# Logging
# Optional ns-3 component logging
NS_LOG="OranLmCommandBridge=level_info|prefix_time"
# NS3_LOG_FILE=ns3-debug.log
