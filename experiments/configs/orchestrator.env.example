# Workspace
A1GENT_NS3_DIR=workspace/ns-3.42

# Logging
# Python-side log level
PY_AGENT_LOG=INFO

# LLM backend
# 1 = enable the LLM-backed agent
ENERGY_USE_LLM=1
LOAD_USE_LLM=1
QOE_USE_LLM=1
# OPENROUTER_API_KEY=...

# Orchestrator cadence and snapshot
# Main control-loop period in seconds
CYCLE_S=2
# Lookback window for network-level KPIs
SNAPSHOT_WINDOW_S=120
# Lookback window for per-UE time series
UE_SERIES_WINDOW_S=90
# Keep the top-K neighbors per UE
UE_NEIGHBOR_TOPK=3

# Readiness gate
# Wait before the first control cycle
ORCH_WARMUP_S=6
# Expected counts for declaring the system ready
EXPECTED_UES=20
# 3 sites x 3 sectors
EXPECTED_CELLS=9
ORCH_WARMUP_UE_FRAC=0.85
IDLE_CYCLES_BEFORE_EXIT=45

# Intent schedule and arbitration order
# Emergency interval in seconds
INTENT_EMERGENCY_START_S=60
INTENT_EMERGENCY_DURATION_S=90
# Agent priority order for each intent phase
INTENT_NORMAL_ORDER=load,qoe,energy
INTENT_EMERGENCY_ORDER=qoe,load,energy
INTENT_RECOVERY_ORDER=load,energy,qoe

# Online tuning
# 1 = enable the APT tuner
APT_ENABLE=0

# Energy policy guardrails
# Sleep eligibility
ENERGY_SLEEP_WINDOW_S=150
ENERGY_SLEEP_MIN_DWELL_S=90
ENERGY_PRB_SLEEP_MAX=0.12
ENERGY_SCHED_SLEEP_MAX=0.30
ENERGY_UE_SLEEP_MAX=2
ENERGY_HO_RATE_MAX=0.015

# Wake triggers
ENERGY_WAKE_WINDOW_S=8
ENERGY_ACTIVE_PRB_WAKE=0.48
ENERGY_WAKE_UE_COUNT_MIN=2
ENERGY_WAKE_SCHED_MIN=0.45

# Safety floors
ENERGY_MIN_ACTIVE_CELLS=6
ENERGY_HEADROOM_MIN=0.25
ENERGY_NEIGH_RSRP_MIN_DBM=-105.0

# QoE policy guardrails
# Distress detection
# Minimum fraction of bad recent samples to mark a UE distressed
QOE_ROLLING_WINDOW_S=10
QOE_DL_MIN_MBPS=0.45
QOE_SINR_MIN_DB=3
QOE_DISTRESS_RATIO_MIN=0.667

# Target eligibility
# Minimum neighbor headroom required for a QoE-driven handover target
QOE_NEIGHBOR_HEADROOM_MIN=0.18
QOE_MIN_DWELL_S=8
QOE_MAX_CANDIDATES=5

# Action pacing
QOE_UE_HO_BAN_S=45
QOE_CIO_HO_COOLDOWN_S=18

# Load policy guardrails
# Pair selection
# Headroom is defined as 1 - PRB utilization
# Cells above/below these headroom thresholds are treated as hot/cool
LOAD_ROLLING_WINDOW_S=4
LOAD_HEADROOM_HOT_MAX=0.88
LOAD_HEADROOM_COOL_MIN=0.78
LOAD_MAX_PAIRS=4
LOAD_ELEPHANTS_PER_PAIR=1

# CIO actuation
LOAD_CIO_MIN_DB=-6.0
LOAD_CIO_MAX_DB=6.0
LOAD_CIO_STEP_DB=1.0
LOAD_CIO_INTERVAL_S=35

# Handover guards
LOAD_HO_MIN_SINR_DB=0
LOAD_HO_TARGET_MCS_P50_MIN=6
LOAD_HO_TARGET_UL_INTERF_MAX_DBM=-84
LOAD_HO_DWELL_MIN_S=8
LOAD_HO_COOLDOWN_S=35

# Logging override
# Optional orchestrator log file
# ORCH_LOG_FILE=orch.log
